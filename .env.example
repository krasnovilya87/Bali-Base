# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Freeimage.host API key for browser builds that still use direct uploads.
VITE_FREEIMAGE_API_KEY=

# Server-only Freeimage.host API key for the Cloud Run image upload proxy.
FREEIMAGE_API_KEY=

# Firebase client API key, loaded from .env.local and used by both client and server wrappers.
VITE_FIREBASE_API_KEY=MY_FIREBASE_API_KEY

# Google Maps client API key for map loading and nearby place search.
VITE_GOOGLE_MAPS_PLATFORM_KEY=MY_GOOGLE_MAPS_PLATFORM_KEY

# Server-only Google Places API key for reviews and refresh jobs.
GOOGLE_PLACES_API_KEY=MY_GOOGLE_PLACES_API_KEY

# Firebase Admin service account for server-side Firestore writes.
# Use one of these two options. Keep the JSON file out of git.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

GOOGLE_PLACES_MAX_MONTHLY_REQUESTS=9500
GOOGLE_PLACES_CREATION_REQUEST_RESERVE=500
GOOGLE_PLACES_ESTIMATED_FREE_REQUESTS=10000
GOOGLE_PLACES_MAX_DAILY_CRON_REQUESTS=300
GOOGLE_PLACES_REVIEWS_CACHE_TTL_DAYS=14
