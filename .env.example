# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ImgBB API key for uploading user listing photos
VITE_IMGBB_API_KEY=

# Server-only Google Places API (New) key.
# Do not expose this as VITE_*; reviews refresh must run from server/cron only.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_MONTHLY_REQUESTS=9500
GOOGLE_PLACES_CREATION_REQUEST_RESERVE=500
GOOGLE_PLACES_ESTIMATED_FREE_REQUESTS=10000
GOOGLE_PLACES_MAX_DAILY_CRON_REQUESTS=300
GOOGLE_PLACES_REVIEWS_CACHE_TTL_DAYS=14
