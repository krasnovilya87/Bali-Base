rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email in ['krasnovilya87@gmail.com'];
    }

    function isValidListing(data) {
      return data.id is string && data.id.size() <= 128
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.category is string && data.category.size() <= 64
        && data.title is string && data.title.size() <= 200
        && data.district is string && data.district.size() <= 64
        && data.status is string && (data.status == 'active' || data.status == 'paused' || data.status == 'draft' || data.status == 'moderation' || data.status == 'rejected')
        && (data.pricePerDay is int || data.pricePerDay is float) && data.pricePerDay >= 0;
    }

    function isValidBookingRequest(data) {
      return data.id is string && data.id.size() <= 128
        && data.listingId is string && data.listingId.size() <= 128
        && data.guestName is string && data.guestName.size() <= 128
        && data.guestPhone is string && data.guestPhone.size() <= 64
        && data.status is string && (data.status == 'pending' || data.status == 'accepted' || data.status == 'declined')
        && (data.totalPrice is int || data.totalPrice is float) && data.totalPrice >= 0;
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(listingId) && isValidListing(incoming()) && isOwner(incoming().ownerId);
      allow update: if isSignedIn() && isValidId(listingId) && isValidListing(incoming()) && isOwner(existing().ownerId) && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(listingId) && isOwner(existing().ownerId);
    }

    match /housing_for_rent_listing/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(listingId) && isValidListing(incoming()) && isOwner(incoming().ownerId);
      allow update: if isSignedIn() && isValidId(listingId) && isValidListing(incoming()) && isOwner(existing().ownerId) && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(listingId) && isOwner(existing().ownerId);
    }

    match /transport_for_rent/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(listingId) && isValidListing(incoming()) && isOwner(incoming().ownerId);
      allow update: if isSignedIn() && isValidId(listingId) && isValidListing(incoming()) && isOwner(existing().ownerId) && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(listingId) && isOwner(existing().ownerId);
    }

    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(bookingId) && isValidBookingRequest(incoming());
      allow update: if isSignedIn() && isValidId(bookingId) && isValidBookingRequest(incoming());
      allow delete: if isSignedIn() && isValidId(bookingId);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin()
        || (isOwner(userId)
          && incoming().uid == userId
          && incoming().role == 'guest'
          && incoming().status == 'active');
      allow update: if isAdmin()
        || (isOwner(userId)
          && incoming().uid == userId
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'uid',
            'email',
            'displayName',
            'photoURL',
            'provider',
            'termsAccepted',
            'termsAcceptedAt',
            'updatedAt',
            'contactName',
            'contactPhone',
            'phoneNumber',
            'whatsappNumber'
          ]));
      allow delete: if isAdmin();
    }

    match /auth_email_providers/{emailKey} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && incoming().uid == request.auth.uid
        && incoming().email is string
        && incoming().email.size() <= 254;
      allow delete: if false;
    }

    match /configs/{configId} {
      allow read, write: if true;
    }

    match /google_places_review_cache/{listingId} {
      allow read: if true;
      allow write: if true;
    }

    match /google_places_api_usage/{monthKey} {
      allow read: if true;
      allow write: if true;
    }

    match /google_places_api_request_log/{logId} {
      allow read, write: if true;
    }
  }
}
